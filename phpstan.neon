# ==============================================================================
# RemitIQ Household Service
# PHPStan Configuration
# ==============================================================================

includes:
  - vendor/larastan/larastan/extension.neon

parameters:
  paths:
    - app

  ignoreErrors:
    - '#Call to an undefined static method PHPOpenSourceSaver\\JWTAuth\\Facades\\JWTAuth::(fromUser|factory)\(\)#'

  # Start with moderate strictness.
  # Increase after architecture stabilizes.
  level: 5

  # Laravel bootstrap
  bootstrapFiles:
    - bootstrap/app.php
    - vendor/autoload.php

  # Exclude generated/framework files
  excludePaths:
    - database/*
    - storage/*
    - bootstrap/cache/*
