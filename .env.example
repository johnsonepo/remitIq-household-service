##############################################
# Production Image
##############################################
# These select which pre-built image the household-service-prod / queue-prod
# services pull. CI pushes to ghcr.io/<owner>/<repo> with tags: the branch
# name, the commit sha, and "latest" on the default branch.

REGISTRY=ghcr.io
IMAGE_NAME=your-org/remitiq-household-service
IMAGE_TAG=latest

##############################################
# Application
##############################################

APP_NAME="RemitIQ Household Service"
APP_ENV=production
APP_KEY=                          # generate with: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://api.yourdomain.com

FRONTEND_URL=https://app.yourdomain.com

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

##############################################
# Logging
##############################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

##############################################
# Database
##############################################
# These credentials are also used by the household-db container's
# POSTGRES_* env vars, so keep them in sync if you self-host Postgres here.
# If you move to a managed database, set DB_HOST to that instance instead
# and you can remove the household-db service.

DB_CONNECTION=pgsql
DB_DATABASE=remitiq_household_db
DB_USERNAME=                      # do not reuse the local dev value
DB_PASSWORD=                      # generate a strong secret, do not commit

##############################################
# Cache / Session / Queue
##############################################

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.yourdomain.com

QUEUE_CONNECTION=redis

##############################################
# Redis
##############################################

REDIS_CLIENT=predis
REDIS_PASSWORD=                   # generate a strong secret, do not commit

##############################################
# JWT Authentication
##############################################

JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_PRIVATE_KEY="file:///var/www/html/storage/app/keys/jwt-private.pem"
JWT_PUBLIC_KEY="file:///var/www/html/storage/app/keys/jwt-public.pem"
JWT_ALGO=RS256
JWT_PASSPHRASE=

##############################################
# Mail
##############################################

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

##############################################
# Market Service
##############################################

MARKET_SERVICE_URL=http://remitiq-market-service:4001/api/v1
MARKET_SERVICE_TIMEOUT=10

##############################################
# Notification Service
##############################################

NOTIFICATION_SERVICE_URL=http://notification-service:4002
NOTIFICATION_SERVICE_API_KEY=     # shared secret, do not commit
NOTIFICATION_SERVICE_TIMEOUT=5

##############################################
# CORS
##############################################

CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

##############################################
# Rate Limiting / Security
##############################################

RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=60
PASSWORD_HASH_ROUNDS=12

##############################################
# Monitoring
##############################################

METRICS_ENABLED=true

##############################################
# Scheduler
##############################################

SCHEDULER_ENABLED=true

##############################################
# Feature Flags
##############################################

ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_ANALYTICS=true
ENABLE_MARKET_SYNC=true
