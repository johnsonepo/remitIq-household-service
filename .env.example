
##############################################
# Application
##############################################

APP_NAME="RemitIQ Household Service"
FRONTEND_URL=http://localhost:3000

APP_ENV=local
APP_KEY=base64:Mj/SjsZrTa/+MjuwgbixFyueV2/H3ugq4qlf1b+/mtk=
APP_DEBUG=true
APP_URL=http://localhost:8000

##############################################
# Application Settings
##############################################

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

##############################################
# Logging
##############################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

##############################################
# Database
##############################################

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=remitiq_household_db
DB_USERNAME=postgres34
DB_PASSWORD=postgres

##############################################
# Cache
##############################################

CACHE_STORE=redis

##############################################
# Session
##############################################

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

##############################################
# Queue
##############################################

QUEUE_CONNECTION=redis

##############################################
# Broadcasting
##############################################

BROADCAST_CONNECTION=log

##############################################
# Filesystem
##############################################

FILESYSTEM_DISK=local
MEDIA_DISK=local

##############################################
# Mail
##############################################

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@remitiq.local"
MAIL_FROM_NAME="${APP_NAME}"

##############################################
# Redis
##############################################

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

##############################################
# JWT Authentication
##############################################

JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_PRIVATE_KEY="file:///var/www/html/storage/app/keys/jwt-private.pem"
JWT_PUBLIC_KEY="file:///var/www/html/storage/app/keys/jwt-public.pem"
JWT_ALGO=RS256
JWT_PASSPHRASE=

##############################################
# API Configuration
##############################################

API_VERSION=v1
API_PREFIX=api
API_RATE_LIMIT_PER_MINUTE=60

##############################################
# Market Service
##############################################

MARKET_SERVICE_URL=http://remitiq-market-service:4001/api/v1
MARKET_SERVICE_TIMEOUT=10

##############################################
# CORS
##############################################

CORS_ALLOWED_ORIGINS=http://localhost:3000

##############################################
# Rate Limiting
##############################################

RATE_LIMIT_ENABLED=true

##############################################
# Security
##############################################

PASSWORD_HASH_ROUNDS=12

##############################################
# Monitoring
##############################################

METRICS_ENABLED=true

##############################################
# Scheduler
##############################################

SCHEDULER_ENABLED=true

##############################################
# Docker
##############################################

DOCKER_TARGET=production
WWWUSER=1000
WWWGROUP=1000

##############################################
# Frontend URLs
##############################################

WEB_URL=http://localhost:3000
MOBILE_URL=expo://localhost

##############################################
# Feature Flags
##############################################

ENABLE_EMAIL_VERIFICATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_ANALYTICS=true
ENABLE_MARKET_SYNC=true

##############################################
# Notification
##############################################

NOTIFICATION_SERVICE_URL=http://notification-service:4002
NOTIFICATION_SERVICE_API_KEY=
NOTIFICATION_SERVICE_TIMEOUT=5
